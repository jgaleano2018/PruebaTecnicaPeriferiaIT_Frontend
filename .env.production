APP_NAME=Periferia Social
APP_PRODUCTION=true
# Reemplace por el dominio público del API Gateway (HTTPS/WSS en producción)
API_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8080
FEED_PAGE_SIZE=10
HTTP_RETRY_COUNT=2
HTTP_RETRY_DELAY_MS=500
WS_MAX_RECONNECT_DELAY_MS=30000
POST_MAX_LENGTH=280

{
  "name": "prueba-tecnica-periferia-it-frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "env:dev": "node scripts/set-env.mjs development",
    "env:prod": "node scripts/set-env.mjs production",
    "env:mobile": "node scripts/set-env.mjs mobile",
    "start": "npm run env:dev && ng serve",
    "build": "npm run env:prod && ng build",
    "build:dev": "npm run env:dev && ng build --configuration development",
    "build:mobile": "npm run env:mobile && ng build && npx cap sync",
    "watch": "npm run env:dev && ng build --watch --configuration development",
    "test": "npm run env:dev && ng test",
    "test:ci": "npm run env:dev && ng test --watch=false",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/signals": "^21.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.5.2",
    "dotenv": "^17.4.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}

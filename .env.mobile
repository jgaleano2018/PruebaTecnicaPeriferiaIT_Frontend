# Build para Capacitor. En el emulador de Android el host es 10.0.2.2;
# en un dispositivo físico use la IP LAN de su equipo (p. ej. http://192.168.1.50:8080).
APP_NAME=Periferia Social
APP_PRODUCTION=true
API_BASE_URL=http://10.0.2.2:8080
WS_BASE_URL=ws://10.0.2.2:8080
FEED_PAGE_SIZE=10
HTTP_RETRY_COUNT=2
HTTP_RETRY_DELAY_MS=500
WS_MAX_RECONNECT_DELAY_MS=30000
POST_MAX_LENGTH=280

# Copie a .env.development / .env.production / .env.mobile según el ambiente.
# Las variables de entorno del proceso (p. ej. build args de Docker) tienen prioridad.

# Nombre visible de la app
APP_NAME=Periferia Social
# true habilita optimizaciones y oculta trazas de depuración
APP_PRODUCTION=false
# URL base del API Gateway (sin "/" final)
API_BASE_URL=http://localhost:8080
# URL base WebSocket del API Gateway (ws:// o wss://)
WS_BASE_URL=ws://localhost:8080
# Publicaciones por página del feed (máx. 50)
FEED_PAGE_SIZE=10
# Reintentos automáticos de peticiones GET ante errores de red/5xx
HTTP_RETRY_COUNT=2
HTTP_RETRY_DELAY_MS=500
# Espera máxima entre reintentos de reconexión del WebSocket
WS_MAX_RECONNECT_DELAY_MS=30000
# Longitud máxima de una publicación (debe coincidir con el backend)
POST_MAX_LENGTH=280
